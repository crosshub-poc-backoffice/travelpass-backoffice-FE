# FE 설정. 이 파일을 .env 로 복사해서 쓴다 (cp .env.example .env). 운영은 같은 이름을 Vercel 환경변수로 넣는다.
# 코드에 기본값이 없다 — 하나라도 빠지면 npm run dev·서버 시작 때 빠진 이름을 전부 알려주고 멈춘다 (lib/env.mjs).
# FE 는 DB·파일 저장소·Upstage 에 붙지 않는다. 데이터는 전부 BE API 로 받는다. <...> 는 직접 채운다.

# BE 주소 (BE 레포, 로컬 bootRun 은 8081)
BACKEND_API_URL=http://localhost:8081

# Keycloak 로그인 (keycloak-auth 레포, tp-office realm 의 tp-office-partner-web client — Confidential + PKCE)
# issuer 는 BE 의 KEYCLOAK_OFFICE_ISSUER_URI 와 글자 하나까지 같아야 한다
KEYCLOAK_OFFICE_ISSUER_URI=http://localhost:8080/realms/tp-office
KEYCLOAK_CLIENT_ID=tp-office-partner-web
KEYCLOAK_CLIENT_SECRET=<keycloak-auth/.env 의 TP_OFFICE_PARTNER_WEB_CLIENT_SECRET>

# 세션에 저장하는 Keycloak 토큰 암호화 키 (AES-256-GCM, 32바이트). 만들기: openssl rand -base64 32
# 바꾸면 기존 로그인 세션은 모두 로그아웃된다
SESSION_ENCRYPTION_KEY=<openssl rand -base64 32>

# 로그인 세션 저장소 (FE 전용 Redis). 로컬 주소면 npm run dev 가 infra/redis 컨테이너를 켠다
# 운영(Vercel)은 Upstash 의 TLS 주소: rediss://default:<password>@<host>:6379
REDIS_URL=redis://localhost:6379
