// 접속 주소는 prisma.config.ts에서 관리 (Prisma 7)
//
// 테이블 구조의 주인은 BE(Flyway, travelpass-backoffice-BE/src/main/resources/db/migration)다.
// 이 파일은 FE가 Prisma Client 타입을 만드는 용도로만 쓴다 — 여기서 마이그레이션을 만들지 않는다.
// BE에 V2 이상이 생기면 그 변경을 이 파일에 손으로 맞추고 `npx prisma generate`.
// prisma/migrations는 BE로 넘기기 전(56개)까지의 옛 이력이라 그대로 두고 고치지 않는다.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  crosshub
  affiliate
  partner
}

model Affiliate {
  id        String   @id @default(cuid())
  name      String
  // 연맹 몫: 대행 업체의 수수료 중 연맹이 가져가는 %p (업체 수수료율 안에서 배분, 업체에겐 안 보임). 비우면 0
  shareRate Int?
  // 연맹 몫을 송금할 정산 계좌 (업체 정산 계좌와 같은 3칸). 크로스허브가 결제 설정에서 입력
  bankName          String?
  bankAccountNumber String?
  bankAccountHolder String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  proxyPartners Partner[]
  users         User[]
  settlements   AffiliateSettlement[]
}

// 업체. proxyAffiliateId가 비어 있으면 직접 운영, 있으면 그 제휴사가 대행
model Partner {
  id               String     @id @default(cuid())
  name             String
  proxyAffiliateId String?
  proxyAffiliate   Affiliate? @relation(fields: [proxyAffiliateId], references: [id], onDelete: Restrict)

  // 업체별 운영정보
  manager                    String?
  email                      String?
  active                     Boolean          @default(true)
  commissionRate             Int?
  // 통화. 상품가·결제·정산이 전부 이 통화 (통화마다 PG 하나, 환율 없음). 예약이 생긴 뒤에는 못 바꾼다
  currency                   String           @default("JPY")
  businessRegistrationNumber String?
  phone                      String?
  address                    String?
  // 정산 계좌. 크로스허브가 정산액을 송금할 곳. 민감정보 — 평문 저장. 운영 단계에서 암호화·별도 보관 검토
  bankName                   String?
  bankAccountNumber          String?
  bankAccountHolder          String?
  // 해외송금용 은행코드 (SWIFT/BIC)
  bankCode                   String?
  memo                       String?
  // 사업자 정보
  representativeName         String? // 대표자명
  corporateName              String? // 법인명
  businessLicenseUrl         String? // 사업자등록증 파일 URL (lib/storage.ts)
  // 부담당자
  subManager                 String?
  subManagerPhone            String?
  // 계약 기간

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  users       User[]
  products    Product[]
  bookings    Booking[]
  settlements Settlement[]
  auditLogs   AuditLog[]

  @@index([proxyAffiliateId])
}

// 계정. 역할에 따라 affiliateId(연맹) 또는 partnerId(업체) 하나만 채운다
model User {
  id                 String     @id @default(cuid())
  loginId            String     @unique
  name               String
  role               Role
  affiliateId        String?
  affiliate          Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  partnerId          String?
  partner            Partner?   @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  active             Boolean    @default(true)
  lastLoginAt        DateTime?  @db.Timestamptz
  createdAt          DateTime   @default(now()) @db.Timestamptz
  updatedAt          DateTime   @updatedAt @db.Timestamptz

  sessions                Session[]
  notifications           Notification[]
  liveNotifDismissals     LiveNotificationDismissal[]
  requestedProductChanges ProductChangeRequest[]      @relation("ProductChangeRequested")
  resolvedProductChanges  ProductChangeRequest[]      @relation("ProductChangeResolved")
  auditLogs               AuditLog[]
  loginLogs               LoginLog[]
  accessLogs              AccessLog[]

  @@index([partnerId])
  @@index([affiliateId])
}

// 작업 이력. 데이터를 바꾸는 작업만 남긴다 (조회·로그인은 남기지 않음). 작업 종류는 lib/audit.ts
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  partnerId  String? // 대상 업체. 크로스허브·연맹 계정 작업처럼 업체와 무관하면 비움
  partner    Partner? @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  action     String
  targetId   String?
  targetName String? // 대상이 지워져도 무엇이었는지 보이도록 이름을 복사해 둔다
  detail     Json? // 바뀐 값 { 필드: [이전값, 새값] }. 수수료율·상품 상태만
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([createdAt])
  @@index([partnerId, createdAt])
}

enum LoginEvent {
  login
  logout
  failed
}

// 로그인 내역. 실패도 남긴다 (없는 ID로 시도하면 userId는 비우고 입력한 ID만)
model LoginLog {
  id         String     @id @default(cuid())
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginId    String
  event      LoginEvent
  failReason String? // wrongPassword / unknownId / inactive
  ip         String?
  userAgent  String?
  createdAt  DateTime   @default(now()) @db.Timestamptz

  @@index([createdAt])
  @@index([userId, createdAt])
  // 로그인 시도 제한 (lib/server/auth/service.ts의 isLoginLocked)
  @@index([loginId, createdAt])
  @@index([ip, createdAt])
}

// 접근 기록. 메뉴를 열거나(view) 처리한(action) 기록. 30일 지나면 cron이 지운다
model AccessLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menu      String
  kind      String // view / action
  path      String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([createdAt])
}

// 로그인 세션. 쿠키에는 원래 토큰, DB에는 토큰의 해시를 id로 저장
model Session {
  id              String   @id
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activePartnerId String? // 업체 전환으로 고른 업체. 비어 있으면 관리 범위 전체
  expiresAt       DateTime @db.Timestamptz
  createdAt       DateTime @default(now()) @db.Timestamptz

  // Keycloak 로그인 세션 정보 (토큰은 AES-256-GCM 암호화된 값).
  // 토큰은 브라우저에 안 내리고 서버 DB에만 둔다 — BE 호출 시 Bearer로 붙이고, 만료되면 refresh로 갱신
  kcAccessToken      String?
  kcAccessExpiresAt  DateTime? @db.Timestamptz
  kcRefreshToken     String?
  kcIdToken          String? // 로그아웃 때 id_token_hint로 보낸다
  // 백채널 로그아웃: Keycloak이 보낸 logout token의 sid(SSO 세션)·sub(유저)로 이 세션을 찾아 지운다
  kcSid              String?
  kcSub              String?

  @@index([userId])
  @@index([kcSid])
  @@index([kcSub])
}

enum ConfirmType {
  instant
  quote
}

enum ProductStatus {
  draft // 임시저장 (아직 심사 요청 전. 앱에 안 나가고 크로스허브 승인 대상도 아님)
  review // 심사중 (등록·수정 직후)
  live // 노출중 (크로스허브 승인)
  hidden // 숨김
}

enum ProductCategory {
  tour // 관광·체험
  lodging // 숙박
  transport // 교통
  package // 패키지
  other // 기타 (기존 상품 등록 화면 그대로)
}

// 종류 구분 없는 단일 상품 모양 (상품 등록 화면 설계 프로토타입 그대로).
model Product {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  status             ProductStatus @default(review)
  // 업체 비활성화로 자동 숨김된 상품. 다시 활성화할 때 이것만 골라 되돌린다 (업체가 직접 숨긴 상품과 구분)
  hiddenByPartnerOff Boolean       @default(false)
  // 심사(review) 반려 사유. live가 되면(재승인) 지운다. ProductChangeRequest.rejectReason과 별개 — review 단계는 그 구조를 안 거친다
  reviewRejectReason String?
  confirmType        ConfirmType     @default(instant)
  category           ProductCategory @default(other)
  name               String
  images             String[]      @default([]) // 사진 경로(공개 URL). 첫 장이 대표. 파일은 lib/storage.ts가 다룬다
  description        String        @default("")
  // 상품 정보를 입력한 언어(ko, en, ja …). 처음 번역할 때 자동 감지하고, 번역 화면에서 바꿀 수 있다. null = 아직 모름
  sourceLocale       String?

  // 판매 일정(기본 일정·회차·예외) — 형태는 lib/products/schedule.ts의 SaleSchedule.
  // "{}"(미설정)면 정원 제한 없음으로 본다 — 예약 생성 때 날짜별 정원 체크(hasCapacity)가 이 값을 쓴다.
  schedule     Json      @default("{}")
  // 판매 기간: 직접 입력하지 않고 저장할 때 schedule에서 계산 (실제로 파는 첫날~마지막 날)
  saleStart    DateTime? @db.Date
  saleEnd      DateTime? @db.Date
  // 예약 마감: 출발 deadlineDays일 전 deadlineTime("HH:MM")까지
  deadlineDays Int       @default(1)
  deadlineTime String    @default("17:00")

  // 취소 수수료 규칙 [{ daysBefore, percent }] — 형태는 lib/products/types.ts의 CancelRule
  cancelRules Json @default("[]")

  priceFrom  Int? // 목록에 보여줄 대표가. 저장할 때 계산
  // 여행 요금표 { categories, plans, priceImages, priceText } — lib/products/types.ts의 PriceTable
  priceTable Json
  // 상세 섹션들(일정표·체험 프로그램·그 외 자유 추가). blocks[0]은 화면에서 제목을 못 바꾸는 "일정표" 고정 섹션 —
  // 형태는 lib/products/types.ts의 Block[]. priceTable과 분리해서, 일정표만 고쳐도 요금표를 다시 안 써도 된다.
  blocks     Json @default("[]")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  inquiries      Inquiry[]
  bookings       Booking[]
  changeRequests ProductChangeRequest[]
  translations   ProductTranslation[]
  inspections    ProductInspection[]

  @@index([partnerId])
  @@index([status])
}

// 상품 정보의 언어별 번역. 원문 언어 말고 나머지 언어마다 1행.
// 번역할 글은 lib/products/translation.ts의 productTexts()가 키("name", "b.<블록id>.text" …)로 뽑는다
model ProductTranslation {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale    String

  // 키 → 번역문
  texts   Json    @default("{}")
  // 키 → 번역할 때의 원문. 지금 원문과 다르면 "원문 변경"으로 표시한다
  sources Json    @default("{}")
  // 사람이 번역을 확인했는지. 자동 번역·다시 번역하면 false로 돌아간다
  reviewed Boolean @default(false)

  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([productId, locale])
}

enum ProductChangeType {
  edit
  delete
  hide // 노출↔숨김 양방향 전환. 방향은 ProductChangeRequest.targetStatus로 구분
}

enum ProductChangeRequestStatus {
  pending
  approved
  rejected
}

// 이미 최초 심사(review)를 통과한(live/hidden) 상품을 연맹·업체가 수정/삭제/숨김전환하면 즉시 반영하지
// 않고 요청만 만든다. 크로스허브가 승인해야 실제로 반영된다 (review 상태 상품은 지금처럼 자유 수정 —
// 이 요청 구조를 안 거친다). 한 상품에 pending 요청은 동시에 1개만 허용 (서비스 레이어에서 확인).
model ProductChangeRequest {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type         ProductChangeType
  targetStatus ProductStatus? // type=hide일 때만 사용
  proposedData Json? // type=edit일 때만: ProductInput 전체(lib/products/types.ts)

  status ProductChangeRequestStatus @default(pending)

  requestedById String
  requestedBy   User   @relation("ProductChangeRequested", fields: [requestedById], references: [id], onDelete: Restrict)

  resolvedById String?
  resolvedBy   User?     @relation("ProductChangeResolved", fields: [resolvedById], references: [id], onDelete: Restrict)
  resolvedAt   DateTime? @db.Timestamptz
  rejectReason String? // 반려 사유(수동 입력 또는 크로스허브 직접처리로 인한 자동반려 문구)

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([productId])
  @@index([status])
}

// 상품 검수 결과 1회분. 사람의 행위가 아니라 기계 판정이라 AuditLog에 넣지 않는다
// (AuditLog.detail은 "수수료율·상품 상태만"으로 좁혀져 있고 userId가 필수다).
// 형태는 lib/server/inspect/types.ts의 Finding[] — 사람이 읽을 문구는 넣지 않고 code와 근거만 담는다.
model ProductInspection {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // 변경요청 검수면 그 요청 id. 최초 심사 검수면 null
  changeRequestId String?

  status  String // 'done' | 'failed'
  verdict String // 'pass' | 'warn' | 'review' — 목록 배지가 Json을 열지 않고 쓰도록 따로 둔다
  aiRan   Boolean @default(false) // AI 검사를 실제로 돌렸는지 (키가 없으면 false)

  findings Json @default("[]")

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([productId, createdAt])
  @@index([changeRequestId])
}

enum BookingStatus {
  pending
  quoted
  confirmed
  rejected
  completed
  canceled
  refunded
  withdrawn // 신청취소: 결제 전(접수대기·견적발송)에 고객이 물러남. 돈이 오간 적 없어 그대로 끝
}

enum CustomerDecision {
  waiting
  accepted
  declined
}

model Booking {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  partnerId    String // 업체 범위 필터용 스냅샷(Product.partnerId). 생성 시점에 고정 — 상품이 다른 업체로 옮겨가지 않으니 바뀔 일 없음
  partner      Partner  @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  customerName String
  phone        String? // 고객 연락처
  email        String? // 고객 이메일
  nationality  String // ISO 3166-1 국가코드(KR, JP …). 화면에서 보는 사람 언어로 국가명을 바꿔 보여준다
  useDate      DateTime @db.Date
  people       Int
  amount       Int // 판매가(실제 결제 금액). Product.priceFrom과 별개 (옵션 등으로 달라질 수 있음)

  // 금액 스냅샷. 예약 시점의 업체 수수료율로 계산해 저장하므로 나중에 수수료율을 바꿔도 과거 예약은 안 바뀐다 (lib/fees.ts)
  commissionRate Int  @default(0) // 업체 수수료율(%)
  commission     Int  @default(0) // 수수료 = 판매가 × 수수료율
  net            Int  @default(0) // 업체 정산액 = 판매가 − 수수료
  cancelFee      Int? // 취소 수수료. 취소할 때 상품의 cancelRules로 계산. 환불액 = 판매가 − 취소 수수료
  cancelReason   String? // 거절·취소 사유 (운영자가 직접 입력, 선택)
  // 수수료 안의 배분 요율도 예약 시점에 같이 박는다 (연맹 몫 %p는 대행 업체만, 아니면 0. PG 수수료율은 그 통화의 PgSetting)
  affiliateShareRate Int   @default(0)
  pgFeeRate          Float @default(0)
  // 예약 시점에 고객이 실제로 고른 요금 구성 스냅샷(플랜·인원 구성·선택 옵션) — 형태는 lib/bookings/types.ts의 PriceBreakdown
  priceBreakdown Json?

  status      BookingStatus @default(pending)
  confirmType ConfirmType // 예약 신청 시점에 상품이 어떤 확정방식이었는지 저장 (즉시확정/견적확인후확정)

  requestedAt DateTime @default(now()) @db.Timestamptz

  quoteAmount      Int?
  quoteValidUntil  DateTime?         @db.Date
  quoteMessage     String?
  customerDecision CustomerDecision?

  // TP 앱이 예약 신청마다 보내는 멱등키. Inquiry.idempotencyKey와 같은 목적 — 네트워크 재시도·중복 탭으로
  // 같은 요청이 두 번 오면 새로 만들지 않고 기존 예약을 그대로 돌려준다.
  idempotencyKey String? @unique

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  payments Payment[]

  @@index([productId])
  @@index([status])
  @@index([useDate])
  @@index([requestedAt])
  @@index([partnerId, status, useDate])
}

enum PaymentType {
  payment
  refund
}

// 결제내역. PG 거래 1건 = 1행 (결제·환불). 지금은 PG 연동 전이라 예약 확정·환불 처리 때 백오피스가 만든다.
// PG 연동 후에는 PG 웹훅이 pgTransactionId를 채운다
model Payment {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  type            PaymentType
  amount          Int // 통화는 업체 통화 (Partner.currency)
  pg              String // PG사명. 결제 시점의 PgSetting.pgName 복사
  pgTransactionId String?

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([bookingId])
  @@index([createdAt])
}

enum SettlementBasis {
  completed // 이용완료일 기준 (이용일이 속한 달)
  paid // 결제일 기준 (결제가 들어온 달)
}

// 통화별 결제·정산 설정. 통화마다 PG 하나. 숫자는 전부 여기서 바꾼다 (코드에 안 박는다)
model PgSetting {
  currency String          @id // ISO 4217 (JPY, KRW …)
  pgName   String
  feeRate  Float           @default(0) // PG 수수료율(%). 크로스허브 비용, 업체 수수료 안에서 나간다
  basis    SettlementBasis @default(completed)
  payDay   Int             @default(15) // 익월 며칠에 지급하는지 (안내용)

  updatedAt DateTime @updatedAt @db.Timestamptz
}

enum InquiryLanguage {
  en
  zh
  ja
  vi
}

enum InquiryStatus {
  pending
  answered
}

model Inquiry {
  id                 String          @id @default(cuid())
  productId          String
  product            Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  customerName       String
  language           InquiryLanguage
  question           String
  questionTranslated String
  // questionTranslated가 어느 화면 언어(ko, en …)로 번역된 건지. 다른 언어 관리자에겐 원문을 보여준다
  questionTranslatedLocale String?
  answer             String?
  answerTranslated   String?

  status InquiryStatus @default(pending)

  // TP 앱이 접수 요청마다 보내는 멱등키. 네트워크 재시도·중복 탭으로 같은 요청이 두 번 오면
  // 새로 만들지 않고 기존 문의를 그대로 돌려주는 데 쓴다 (중복 행 + 중복 번역 호출 방지).
  idempotencyKey String? @unique

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  messages InquiryMessage[]

  @@index([productId])
  @@index([status])
}

enum MessageSender {
  customer
  admin
}

model InquiryMessage {
  id        String  @id @default(cuid())
  inquiryId String
  inquiry   Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  sender         MessageSender
  text           String
  textTranslated String?
  // 고객 메시지 번역문의 언어(관리자 화면 언어). 관리자 답변의 textTranslated는 항상 문의 언어라 비워 둔다
  translatedLocale String?
  // 관리자 답변 원문(text)을 쓴 관리자의 화면 언어. 다른 언어 관리자가 볼 때 이 언어에서 번역해 보여준다
  textLocale String?

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([inquiryId])
}

enum SettlementStatus {
  pending
  paid
}

model Settlement {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  period         String // "YYYY-MM" 형식. partnerId + period로 월별 정산 1건을 구분
  gross          Int
  commissionRate Int
  commission     Int
  net            Int
  bookingCount   Int

  status  SettlementStatus @default(pending)
  payDate DateTime?        @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([partnerId, period])
  @@index([partnerId])
}

// 연맹 몫 월별 지급. 업체 Settlement와 같은 방식: 지급대기 동안은 대행 업체 정산에서 계산하고, 지급완료 때 금액을 굳힌다.
// 업체 지급과 따로 월 1회 — 업체 행이 다 지급완료가 아니어도 연맹 지급은 할 수 있다. 통화별로 1행 (대행 업체 통화가 섞이면 통화마다)
model AffiliateSettlement {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  period       String // "YYYY-MM"
  currency     String
  amount       Int // 연맹 몫 합계
  partnerCount Int // 정산 기준 금액이 있는 대행 업체 수

  status  SettlementStatus @default(pending)
  payDate DateTime?        @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([affiliateId, period, currency])
}

// 서류/개발/통합_알림_기능_설계.md 참고. 11개 후보 중 실제로 보내는 5개(예약 신규접수·문의 신규접수·
// 상품 심사요청은 live-state라 이 enum에 안 들어감)만 남긴 상태.
enum NotificationType {
  booking_quote_responded
  product_status_changed
  product_change_requested // 연맹·업체가 요청 생성 → 크로스허브
  product_change_resolved // 크로스허브 승인·반려(수동·자동) → 요청측(업체+대행연맹). payload.result로 구분
  product_direct_change // 크로스허브 직접 수정/삭제/숨김전환 → 소유측(업체+대행연맹)
}

model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType

  sourceId String // NOT NULL — nullable이면 Postgres가 NULL끼리 다른 값 취급해서 유니크 제약이 안 먹힘
  payload  Json
  read     Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([userId, type, sourceId])
  @@index([userId, read])
  @@index([userId, createdAt])
}

// live-state 알림(Notification 행이 없는 5종)을 특정 유저가 "봤다"고 표시해두는 용도.
// 실제 Booking/Inquiry/Product/Partner 상태는 안 건드린다 — 벨 목록·배지에서만 그 유저에게 숨긴다.
// key는 NotificationItem.id와 같은 형식(예: "booking-<id>", "inquiry-<id>").
model LiveNotificationDismissal {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  createdAt DateTime @default(now()) @db.Timestamptz

  @@id([userId, key])
}
